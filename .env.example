# PostgreSQL — Docker container
# Port 5433 avoids conflict with any local Postgres install on the default 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=retail
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail

# SFTP — Docker container (mock of the store upload server)
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=retail
SFTP_PASSWORD=retail
SFTP_BASE_PATH=/incoming
